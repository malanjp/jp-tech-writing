{
  "name": "tired-dev-docs",
  "version": "0.1.0",
  "description": "疲れたエンジニアが一読で理解できる日本語の技術文書を書くための規約。SessionStart で適用対象を通知し、UserPromptSubmit が共有文章の作成・推敲依頼を検出したときだけ要約を注入する。チャット返答の口調には干渉しない。規約の正本は SKILL.md。",
  "author": {
    "name": "malanjp",
    "url": "https://github.com/malanjp"
  },
  "homepage": "https://github.com/malanjp/skills",
  "repository": "https://github.com/malanjp/skills",
  "license": "MIT",
  "keywords": [
    "japanese",
    "日本語",
    "writing",
    "technical-writing",
    "cognitive-load",
    "proofreading",
    "issue",
    "code-review",
    "hooks",
    "skills"
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/activate.js\"",
            "timeout": 5,
            "statusMessage": "tired-dev-docs 読込中..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/gate.js\"",
            "timeout": 5,
            "statusMessage": "tired-dev-docs 判定中..."
          }
        ]
      }
    ]
  }
}
